rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function listRef(listId) {
      return /databases/$(database)/documents/lists/$(listId);
    }

    function listExists(listId) {
      return exists(listRef(listId));
    }

    function isListMember(listId) {
      return isSignedIn() && listExists(listId) && request.auth.uid in get(listRef(listId)).data.memberIds;
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /lists/{listId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /places/{placeId} {
      allow create: if isSignedIn()
        && request.resource.data.listId is string
        && isListMember(request.resource.data.listId);

      allow read: if isListMember(resource.data.listId);

      allow update: if isListMember(resource.data.listId)
        && request.resource.data.listId == resource.data.listId;

      allow delete: if isListMember(resource.data.listId);
    }
  }
}
